<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>Shveraa - Reset Password</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #0f172a;
            --primary-hover: #1e293b;
            --accent: #6366f1;
            --accent-glow: rgba(99, 102, 241, 0.25);
            --success: #10b981;
            --warning: #f59e0b;
            --error: #ef4444;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --text-subtle: #94a3b8;
            --border-light: #e2e8f0;
            --border-focus: #6366f1;
            --bg-card: #ffffff;
            --bg-page: #f8fafc;
            --font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-family);
            background: var(--bg-page);
            color: var(--text-main);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            overflow-x: hidden;
        }

        .page {
            min-height: 100vh;
            display: grid;
            grid-template-columns: 46% 54%;
        }

        /* ==================== LEFT HERO / BRAND PANEL ==================== */
        .left {
            background: #090d16;
            background-image: 
                radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.18) 0px, transparent 55%),
                radial-gradient(at 100% 100%, rgba(59, 130, 246, 0.14) 0px, transparent 60%),
                radial-gradient(at 100% 0%, rgba(139, 92, 246, 0.12) 0px, transparent 50%),
                linear-gradient(165deg, #090d16 0%, #0f172a 50%, #0a0e1a 100%);
            color: #ffffff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 60px 8%;
            position: relative;
            overflow: hidden;
            border-right: 1px solid rgba(255, 255, 255, 0.08);
        }

        /* Ambient floating light orbs */
        .left::before {
            content: "";
            position: absolute;
            width: 520px;
            height: 520px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.12) 0%, rgba(99, 102, 241, 0) 70%);
            top: -140px;
            right: -180px;
            pointer-events: none;
            animation: pulseOrb 8s ease-in-out infinite alternate;
        }

        .left::after {
            content: "";
            position: absolute;
            width: 440px;
            height: 440px;
            border-radius: 50%;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.10) 0%, rgba(59, 130, 246, 0) 70%);
            bottom: -120px;
            left: -140px;
            pointer-events: none;
            animation: pulseOrb 10s ease-in-out infinite alternate-reverse;
        }

        @keyframes pulseOrb {
            0% { transform: scale(0.95) translate(0, 0); opacity: 0.7; }
            100% { transform: scale(1.1) translate(20px, 20px); opacity: 1; }
        }

        .left-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: relative;
            z-index: 2;
        }

        .logo img {
            width: 125px;
            max-height: 55px;
            object-fit: contain;
            filter: brightness(0) invert(1);
            transition: opacity 0.2s ease;
        }

        .security-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.12);
            backdrop-filter: blur(8px);
            padding: 6px 14px;
            border-radius: 9999px;
            font-size: 11px;
            font-weight: 600;
            color: #cbd5e1;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .pulse-dot {
            width: 7px;
            height: 7px;
            background: #10b981;
            border-radius: 50%;
            box-shadow: 0 0 10px #10b981;
            animation: liveDot 2s infinite;
        }

        @keyframes liveDot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.5; transform: scale(0.85); }
        }

        .brand-content {
            position: relative;
            z-index: 2;
            max-width: 480px;
            margin: auto 0;
            padding: 40px 0;
        }

        .tag-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(99, 102, 241, 0.15);
            border: 1px solid rgba(129, 140, 248, 0.3);
            color: #c7d2fe;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            padding: 5px 12px;
            border-radius: 8px;
            margin-bottom: 24px;
        }

        .brand-content h1 {
            font-size: 46px;
            line-height: 1.15;
            font-weight: 700;
            letter-spacing: -1px;
            margin-bottom: 20px;
            color: #ffffff;
        }

        .brand-content h1 span {
            background: linear-gradient(135deg, #ffffff 40%, #a5b4fc 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .brand-content p {
            font-size: 15.5px;
            line-height: 1.75;
            color: #94a3b8;
            max-width: 430px;
            margin-bottom: 36px;
        }

        /* Glassmorphic Feature Cards */
        .features-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .feature-card {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 14px;
            padding: 14px 18px;
            backdrop-filter: blur(10px);
            display: flex;
            align-items: center;
            gap: 14px;
            transition: all 0.25s ease;
        }

        .feature-card:hover {
            background: rgba(255, 255, 255, 0.07);
            border-color: rgba(255, 255, 255, 0.16);
            transform: translateX(4px);
        }

        .feature-icon-wrap {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: rgba(99, 102, 241, 0.15);
            border: 1px solid rgba(99, 102, 241, 0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #a5b4fc;
            flex-shrink: 0;
        }

        .feature-info strong {
            display: block;
            font-size: 13.5px;
            font-weight: 600;
            color: #ffffff;
            margin-bottom: 2px;
        }

        .feature-info span {
            font-size: 12px;
            color: #94a3b8;
            line-height: 1.4;
        }

        .left-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 12px;
            color: #64748b;
            position: relative;
            z-index: 2;
            padding-top: 20px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .left-footer a {
            color: #94a3b8;
            text-decoration: none;
            transition: color 0.2s;
        }

        .left-footer a:hover {
            color: #ffffff;
        }

        /* ==================== RIGHT FORM PANEL ==================== */
        .right {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 50px 8%;
            background: #ffffff;
            position: relative;
        }

        .form-wrap {
            width: 100%;
            max-width: 460px;
            animation: fadeIn 0.4s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .form-header-badge {
            width: 52px;
            height: 52px;
            background: #eef2ff;
            border: 1px solid #e0e7ff;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent);
            margin-bottom: 22px;
            box-shadow: 0 4px 12px -2px rgba(99, 102, 241, 0.15);
        }

        .form-head {
            margin-bottom: 30px;
        }

        .form-head h2 {
            font-size: 30px;
            font-weight: 700;
            color: var(--primary);
            letter-spacing: -0.6px;
            margin-bottom: 8px;
        }

        .form-head p {
            font-size: 14.5px;
            color: var(--text-muted);
            line-height: 1.6;
        }

        /* Alert message inside form */
        .alert-banner {
            display: none;
            padding: 12px 16px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 20px;
            align-items: center;
            gap: 10px;
            animation: shake 0.3s ease;
        }

        .alert-banner.error {
            display: flex;
            background: #fef2f2;
            border: 1px solid #fee2e2;
            color: #b91c1c;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20%, 60% { transform: translateX(-5px); }
            40%, 80% { transform: translateX(5px); }
        }

        .form-group {
            margin-bottom: 22px;
            position: relative;
        }

        label {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 8px;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 16px;
            color: #94a3b8;
            pointer-events: none;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s ease;
        }

        input {
            width: 100%;
            height: 52px;
            border: 1.5px solid var(--border-light);
            border-radius: 12px;
            padding: 0 46px 0 46px;
            font-size: 14.5px;
            font-family: inherit;
            outline: none;
            background: #f8fafc;
            color: var(--text-main);
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        }

        input:hover {
            border-color: #cbd5e1;
            background: #ffffff;
        }

        input:focus {
            border-color: var(--accent);
            background: #ffffff;
            box-shadow: 0 0 0 4px var(--accent-glow);
        }

        input:focus + .input-icon,
        .input-wrapper:focus-within .input-icon {
            color: var(--accent);
        }

        .toggle-password {
            position: absolute;
            right: 14px;
            background: none;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            padding: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
            transition: all 0.2s ease;
            height: auto;
            width: auto;
            margin: 0;
        }

        .toggle-password:hover {
            color: var(--text-main);
            background: #f1f5f9;
        }

        /* Password Strength Meter */
        .strength-container {
            margin-top: 10px;
            display: none;
        }

        .strength-meter {
            height: 4px;
            width: 100%;
            background: #e2e8f0;
            border-radius: 4px;
            overflow: hidden;
            display: flex;
            gap: 4px;
        }

        .strength-segment {
            flex: 1;
            height: 100%;
            background: transparent;
            transition: background 0.3s ease;
            border-radius: 2px;
        }

        .strength-label {
            font-size: 11.5px;
            color: var(--text-muted);
            margin-top: 6px;
            display: flex;
            justify-content: space-between;
            font-weight: 500;
        }

        .match-indicator {
            font-size: 11.5px;
            margin-top: 6px;
            font-weight: 500;
            display: none;
            align-items: center;
            gap: 4px;
        }

        .match-indicator.matched {
            display: flex;
            color: var(--success);
        }

        .match-indicator.unmatched {
            display: flex;
            color: var(--error);
        }

        /* Action Button */
        button[type="submit"] {
            width: 100%;
            height: 52px;
            border: 0;
            border-radius: 12px;
            background: var(--primary);
            background-image: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
            color: #ffffff;
            font-size: 15px;
            font-weight: 600;
            font-family: inherit;
            cursor: pointer;
            margin-top: 10px;
            box-shadow: 0 10px 20px -5px rgba(15, 23, 42, 0.35), 0 3px 6px -2px rgba(15, 23, 42, 0.15);
            transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            letter-spacing: 0.2px;
        }

        button[type="submit"]:hover {
            background: #020617;
            transform: translateY(-2px);
            box-shadow: 0 14px 26px -6px rgba(15, 23, 42, 0.45);
        }

        button[type="submit"]:active {
            transform: translateY(0);
        }

        .btn-arrow {
            transition: transform 0.2s ease;
        }

        button[type="submit"]:hover .btn-arrow {
            transform: translateX(4px);
        }

        .note-wrap {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            color: var(--text-subtle);
            font-size: 12px;
            margin-top: 20px;
        }

        /* ==================== STATE MESSAGES (SUCCESS / EXPIRED / ERROR) ==================== */
        .message-card {
            text-align: center;
            max-width: 440px;
            margin: auto;
            animation: scaleIn 0.35s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes scaleIn {
            from { opacity: 0; transform: scale(0.96); }
            to { opacity: 1; transform: scale(1); }
        }

        .status-icon {
            width: 76px;
            height: 76px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
            position: relative;
        }

        .status-icon::after {
            content: "";
            position: absolute;
            inset: -8px;
            border-radius: 50%;
            opacity: 0.35;
        }

        .message.success .status-icon {
            background: #ecfdf5;
            color: #059669;
            box-shadow: 0 0 0 1px #a7f3d0;
        }

        .message.success .status-icon::after {
            background: radial-gradient(circle, rgba(16, 185, 129, 0.2) 0%, transparent 70%);
        }

        .message.expired .status-icon {
            background: #fffbeb;
            color: #d97706;
            box-shadow: 0 0 0 1px #fde68a;
        }

        .message.expired .status-icon::after {
            background: radial-gradient(circle, rgba(245, 158, 11, 0.2) 0%, transparent 70%);
        }

        .message.error .status-icon {
            background: #fef2f2;
            color: #dc2626;
            box-shadow: 0 0 0 1px #fecaca;
        }

        .message.error .status-icon::after {
            background: radial-gradient(circle, rgba(239, 68, 68, 0.2) 0%, transparent 70%);
        }

        .message h2 {
            font-size: 28px;
            font-weight: 700;
            color: var(--primary);
            letter-spacing: -0.5px;
            margin-bottom: 12px;
        }

        .message p {
            font-size: 14.5px;
            color: var(--text-muted);
            line-height: 1.7;
            margin-bottom: 28px;
        }

        .btn-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            width: 100%;
            height: 50px;
            border-radius: 12px;
            background: var(--primary);
            color: #ffffff;
            font-size: 14.5px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
            box-shadow: 0 8px 18px -4px rgba(15, 23, 42, 0.3);
        }

        .btn-action:hover {
            background: #020617;
            transform: translateY(-2px);
            box-shadow: 0 12px 22px -4px rgba(15, 23, 42, 0.4);
        }

        /* ==================== RESPONSIVE DESIGN ==================== */
        @media (max-width: 960px) {
            .page {
                grid-template-columns: 1fr;
            }

            .left {
                min-height: auto;
                padding: 40px 6%;
            }

            .brand-content {
                margin: 24px 0;
                padding: 10px 0;
            }

            .brand-content h1 {
                font-size: 34px;
            }

            .features-grid {
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }

            .left-footer {
                display: none;
            }

            .right {
                padding: 50px 6%;
                min-height: auto;
            }
        }

        @media (max-width: 600px) {
            .left {
                padding: 30px 20px;
            }

            .brand-content h1 {
                font-size: 28px;
            }

            .brand-content p {
                font-size: 14px;
                margin-bottom: 20px;
            }

            .features-grid {
                grid-template-columns: 1fr;
            }

            .right {
                padding: 40px 20px;
            }

            .form-head h2 {
                font-size: 24px;
            }
        }
    </style>
</head>

<body>
    <div class="page">

        <!-- ==================== LEFT BRAND SHOWCASE ==================== -->
        <section class="left">
            <div class="left-header">
                <div class="logo">
                    <img src="https://trigontic.com/wp-content/uploads/2018/04/trigontic-227x60.png" alt="Shveraa">
                </div>
                <div class="security-badge">
                    <span class="pulse-dot"></span>
                    <span>256-Bit SSL</span>
                </div>
            </div>

            <div class="brand-content">
                <div class="tag-pill">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                    </svg>
                    Enterprise Security
                </div>
                <h1>Secure your account with a <span>new password.</span></h1>
                <p>Keep your account thoroughly protected with industry-standard cryptographic encryption. You are just one quick step away.</p>

                <div class="features-grid">
                    <div class="feature-card">
                        <div class="feature-icon-wrap">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                            </svg>
                        </div>
                        <div class="feature-info">
                            <strong>Protected Account</strong>
                            <span>End-to-end credential encryption</span>
                        </div>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon-wrap">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                        <div class="feature-info">
                            <strong>Instant Sync</strong>
                            <span>Real-time update across all devices</span>
                        </div>
                    </div>

                    <div class="feature-card">
                        <div class="feature-icon-wrap">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                        </div>
                        <div class="feature-info">
                            <strong>Zero-Trust Privacy</strong>
                            <span>Your confidential data stays strictly private</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="left-footer">
                <span>&copy; <%= new Date().getFullYear() %> Shveraa. All rights reserved.</span>
                <a href="#">Privacy &amp; Terms</a>
            </div>
        </section>

        <!-- ==================== RIGHT FORM / MESSAGE PANEL ==================== -->
        <section class="right">
            <div class="form-wrap">

                <% if(type==="success" ){ %>
                    <!-- SUCCESS STATE -->
                    <div class="message-card message success">
                        <div class="status-icon">
                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                        </div>
                        <h2>Password Updated</h2>
                        <p>Your password has been successfully updated with bank-grade encryption. You can now login with your new credentials.</p>
                        <a href="/login" class="btn-action">
                            <span>Proceed to Login</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </a>
                    </div>

                <% }else if(type==="expired" ){ %>
                    <!-- EXPIRED STATE -->
                    <div class="message-card message expired">
                        <div class="status-icon">
                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <polyline points="12 6 12 12 16 14"></polyline>
                            </svg>
                        </div>
                        <h2>Link Expired</h2>
                        <p>For your security, password reset tokens deactivate after 10 minutes. Please request a fresh reset link to proceed.</p>
                        <a href="/forgot-password" class="btn-action">
                            <span>Request New Reset Link</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </a>
                    </div>

                <% }else if(type==="error" ){ %>
                    <!-- ERROR STATE -->
                    <div class="message-card message error">
                        <div class="status-icon">
                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle>
                                <line x1="15" y1="9" x2="9" y2="15"></line>
                                <line x1="9" y1="9" x2="15" y2="15"></line>
                            </svg>
                        </div>
                        <h2>Invalid Security Link</h2>
                        <p>This password reset link is invalid, already used, or no longer available. Please request a new link.</p>
                        <a href="/forgot-password" class="btn-action">
                            <span>Request Reset Link</span>
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </a>
                    </div>

                <% }else{ %>
                    <!-- DEFAULT RESET FORM -->
                    <div class="form-header-badge">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                        </svg>
                    </div>

                    <div class="form-head">
                        <h2>Reset Password</h2>
                        <p>Create a strong, new password for your Shveraa account. Make sure your password has at least 6 characters.</p>
                    </div>

                    <div id="alertBanner" class="alert-banner">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="12" y1="8" x2="12" y2="12"></line>
                            <line x1="12" y1="16" x2="12.01" y2="16"></line>
                        </svg>
                        <span id="alertMessage">Passwords do not match</span>
                    </div>

                    <form id="resetForm" action="/api/user/auth/reset-password/<%= token %>" method="POST">

                        <!-- NEW PASSWORD -->
                        <div class="form-group">
                            <label for="password">
                                <span>New Password</span>
                                <span style="font-size: 11px; font-weight: 500; color: #94a3b8;">Min 6 characters</span>
                            </label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                    </svg>
                                </span>
                                <input id="password" type="password" name="password" placeholder="Enter your new password" minlength="6" required autocomplete="new-password">
                                <button type="button" class="toggle-password" data-target="password" aria-label="Toggle password visibility">
                                    <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                    <svg class="eye-closed" style="display: none;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                        <line x1="1" y1="1" x2="23" y2="23"></line>
                                    </svg>
                                </button>
                            </div>
                            <!-- Live Strength Indicator -->
                            <div id="strengthContainer" class="strength-container">
                                <div class="strength-meter">
                                    <div class="strength-segment" id="seg1"></div>
                                    <div class="strength-segment" id="seg2"></div>
                                    <div class="strength-segment" id="seg3"></div>
                                    <div class="strength-segment" id="seg4"></div>
                                </div>
                                <div class="strength-label">
                                    <span>Password Strength</span>
                                    <span id="strengthText" style="font-weight: 600;">Weak</span>
                                </div>
                            </div>
                        </div>

                        <!-- CONFIRM PASSWORD -->
                        <div class="form-group">
                            <label for="confirmPassword">
                                <span>Confirm Password</span>
                            </label>
                            <div class="input-wrapper">
                                <span class="input-icon">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                    </svg>
                                </span>
                                <input id="confirmPassword" type="password" name="confirmPassword" placeholder="Re-enter your new password" minlength="6" required autocomplete="new-password">
                                <button type="button" class="toggle-password" data-target="confirmPassword" aria-label="Toggle confirm password visibility">
                                    <svg class="eye-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                    <svg class="eye-closed" style="display: none;" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"></path>
                                        <line x1="1" y1="1" x2="23" y2="23"></line>
                                    </svg>
                                </button>
                            </div>
                            <div id="matchIndicator" class="match-indicator">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"></polyline>
                                </svg>
                                <span id="matchText">Passwords match</span>
                            </div>
                        </div>

                        <!-- SUBMIT BUTTON -->
                        <button type="submit" id="submitBtn">
                            <span>Update Password</span>
                            <svg class="btn-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </button>

                        <div class="note-wrap">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                            </svg>
                            <span>Encrypted with SHA-256 standard security</span>
                        </div>
                    </form>
                <% } %>

            </div>
        </section>

    </div>

    <script>
        // Password Visibility Toggles
        document.querySelectorAll('.toggle-password').forEach(button => {
            button.addEventListener('click', function () {
                const targetId = this.getAttribute('data-target');
                const input = document.getElementById(targetId);
                const eyeOpen = this.querySelector('.eye-open');
                const eyeClosed = this.querySelector('.eye-closed');

                if (input.type === 'password') {
                    input.type = 'text';
                    eyeOpen.style.display = 'none';
                    eyeClosed.style.display = 'block';
                } else {
                    input.type = 'password';
                    eyeOpen.style.display = 'block';
                    eyeClosed.style.display = 'none';
                }
            });
        });

        const passwordInput = document.getElementById('password');
        const confirmPasswordInput = document.getElementById('confirmPassword');
        const strengthContainer = document.getElementById('strengthContainer');
        const strengthText = document.getElementById('strengthText');
        const seg1 = document.getElementById('seg1');
        const seg2 = document.getElementById('seg2');
        const seg3 = document.getElementById('seg3');
        const seg4 = document.getElementById('seg4');
        const matchIndicator = document.getElementById('matchIndicator');
        const matchText = document.getElementById('matchText');
        const alertBanner = document.getElementById('alertBanner');
        const alertMessage = document.getElementById('alertMessage');

        // Dynamic Password Strength Calculator
        if (passwordInput) {
            passwordInput.addEventListener('input', function () {
                const val = this.value;
                if (!val) {
                    strengthContainer.style.display = 'none';
                    return;
                }
                strengthContainer.style.display = 'block';

                let score = 0;
                if (val.length >= 6) score++;
                if (val.length >= 9) score++;
                if (/[0-9]/.test(val) || /[^A-Za-z0-9]/.test(val)) score++;
                if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score++;

                const colors = ['#ef4444', '#f59e0b', '#3b82f6', '#10b981'];
                const labels = ['Weak', 'Moderate', 'Strong', 'Very Strong'];

                [seg1, seg2, seg3, seg4].forEach((seg, i) => {
                    seg.style.background = i < score ? colors[score - 1] : '#e2e8f0';
                });

                strengthText.textContent = labels[score - 1] || 'Weak';
                strengthText.style.color = colors[score - 1] || '#ef4444';

                checkMatch();
            });
        }

        // Live Password Match Check
        function checkMatch() {
            if (!confirmPasswordInput || !passwordInput) return;
            const p1 = passwordInput.value;
            const p2 = confirmPasswordInput.value;

            if (!p2) {
                matchIndicator.style.display = 'none';
                return;
            }

            if (p1 === p2) {
                matchIndicator.className = 'match-indicator matched';
                matchText.textContent = 'Passwords match';
            } else {
                matchIndicator.className = 'match-indicator unmatched';
                matchText.textContent = 'Passwords do not match';
            }
        }

        if (confirmPasswordInput) {
            confirmPasswordInput.addEventListener('input', checkMatch);
        }

        // Form Submission Validation
        document.getElementById("resetForm")?.addEventListener("submit", function (e) {
            const password = document.getElementById("password").value;
            const confirmPassword = document.getElementById("confirmPassword").value;

            if (password !== confirmPassword) {
                e.preventDefault();
                alertBanner.className = 'alert-banner error';
                alertMessage.textContent = 'Passwords do not match. Please verify and try again.';
                confirmPasswordInput.focus();
                return;
            }

            if (password.length < 6) {
                e.preventDefault();
                alertBanner.className = 'alert-banner error';
                alertMessage.textContent = 'Password must be at least 6 characters long.';
                passwordInput.focus();
                return;
            }

            // Hide alert if valid and show loading state
            alertBanner.style.display = 'none';
            const submitBtn = document.getElementById('submitBtn');
            if (submitBtn) {
                submitBtn.innerHTML = '<span>Updating Password...</span>';
                submitBtn.style.opacity = '0.8';
                submitBtn.style.pointerEvents = 'none';
            }
        });
    </script>
</body>

</html>